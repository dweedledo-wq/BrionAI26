# BrionAI26 — omgevingsvariabelen (documentatie, geen waarden)
# Echte waarden alleen op de doelmachine via first-boot-wizard of CLI-login.
# De wizard schrijft AI-sleutels naar ~/.config/brionai26/*.key (chmod 600).

# --- AI-assistenten (gevraagd door de first-boot-wizard) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Infrastructuur (auth via interactieve CLI-login, geen key nodig) ---
TAILSCALE_AUTHKEY=
GITHUB_TOKEN=

# --- Optioneel: services met eigen accounts ---
N8N_ENCRYPTION_KEY=
SUPABASE_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
