#!/bin/sh# Wrapper: bouwt de ISO in een privileged debian:stable container.# live-build heeft chroot/mount nodig; op GitHub Actions-runners (ubuntu-latest)# draait dit direct op de VM. De container benadert geen poorten en publiceert niets.# build/ is gemount zodat live-build.log na een faal beschikbaar blijft (CI leest het).set -eIMAGE=debian:stablemkdir -p build distdocker run --privileged --rm \    --workdir /app \    --volume "${PWD}/bin:/app/bin" \    --volume "${PWD}/config:/app/config" \    --volume "${PWD}/desktop:/app/desktop" \    --volume "${PWD}/brand:/app/brand" \    --volume "${PWD}/build:/app/build" \    --volume "${PWD}/dist:/app/dist" \    "${IMAGE}" \    /bin/bash bin/build-iso /app/build
