#!/bin/sh

# BrionAI26 — fase 2/3/4/5 inbouw in de live-build ISO.
# Wordt door bin/build-iso aangeroepen ná lb config, vóór lb build.
# Idempotent: veilig herhaald uit te voeren.

set -eu

CFG="$1"   # live-build config-map (bv. build/)
HERE="$(dirname "$0")"
LOGO="$HERE/../brand/file_00000000ace471f4822c47ae84fef756.png"
BRAND="$HERE/branding"

# 1) Pakketlijst fase 2: XFCE + mission-control-onderdelen.
mkdir -p "$CFG/config/package-lists"
cat > "$CFG/config/package-lists/brionai26-desktop.list.chroot" <<'EOF'
# BrionAI26 mission-control desktop (fase 2)
xfce4
xfce4-terminal
picom
conky-all
devilspie2
wmctrl
chromium
lightdm
lightdm-gtk-greeter
plymouth
plymouth-themes
imagemagick
gnome-themes-extra
adwaita-icon-theme
fonts-jetbrains-mono
sudo
EOF

# 1b) Pakketlijst fase 3: Dev Studio-devstack.
cat > "$CFG/config/package-lists/brionai26-devstudio.list.chroot" <<'EOF'
# BrionAI26 Dev Studio (fase 3)
geany
git
gitg
tmux
build-essential
python3
python3-pip
python3-venv
nodejs
npm
curl
wget
openssh-client
EOF

# 1b2) Pakketlijst fase 4: Calamares installer.
cat > "$CFG/config/package-lists/brionai26-installer.list.chroot" <<'EOF'
# BrionAI26 installer (fase 4)
calamares
calamares-settings-debian
libxcb-cursor0
EOF

# 1b3) Pakketlijst fase 5: first-boot wizard.
cat > "$CFG/config/package-lists/brionai26-wizard.list.chroot" <<'EOF'
# BrionAI26 first-boot wizard (fase 5)
zenity
EOF
