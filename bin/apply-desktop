#!/bin/sh

# Draait binnen een privileged debian:stable container (zie bin/build-iso-docker).
# Bouwt de BrionAI26 ISO: fase 1 (basis) + fase 2 (mission-control desktop).

set -eu

export DEBIAN_FRONTEND=noninteractive

BASE="$PWD"
CFG="$BASE/brionai26-config"

mkdir -p "$CFG" "$BASE/dist"

# 0) Overlay van onze eigen configuratie (in repo).
cp -a config/. "$CFG/config/"

# 1) live-build basisconfiguratie.
lb config \
  --distribution "trixie" \
  --architecture "amd64" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --bootappend-live "boot=live components quiet splash" \
  --bootloaders "grub-pc,grub-efi" \
  --debian-installer "none" \
  --iso-application "BrionAI26" \
  --iso-publisher "Brionize; https://brionize.nl" \
  --iso-volume "BRIIONAI26" \
  --memtest "true"

# 1b) Pakketlijst fase 2: mission-control desktop.
cat > "$CFG/config/package-lists/brionai26-desktop.list.chroot" <<'EOF'
# BrionAI26 mission control (fase 2)
xfce4
xfce4-terminal
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings
network-manager
network-manager-gnome
xfce4-power-manager
xfce4-screensaver
conky-all
fonts-jetbrains-mono
firefox-esr
thunderbird
libreoffice-calc
libreoffice-writer
vlc
sudo
openssh-client
EOF

# 1b2) Pakketlijst fase 4: Calamares installer.
cat > "$CFG/config/package-lists/brionai26-installer.list.chroot" <<'EOF'
# BrionAI26 installer (fase 4)
calamares
calamares-settings-debian
libxcb-cursor0
EOF
