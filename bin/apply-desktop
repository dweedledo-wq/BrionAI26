#!/bin/sh

# BrionAI26 — fase 2/3/4/5 inbouw in de live-build ISO.
# Wordt door bin/build-iso aangeroepen; plaatst desktop, devstack,
# installer en first-boot-wizard in de live-build configuratieboom.
# Leest het kleurpalet uit brand/theme/mission-control.conf.

set -eu

CFG="${1:?config-map}"
PAL="${2:?palet-bestand}"

# Palet inlezen (BG_DEEP, BG_PANEL, ACCENT_STEEL, ACCENT_GOLD, TEXT_MAIN)
get() { sed -n "s/^$1=//p" "$PAL" | tail -1; }
BG_DEEP="$(get BG_DEEP)"
BG_PANEL="$(get BG_PANEL)"
ACCENT_STEEL="$(get ACCENT_STEEL)"
ACCENT_GOLD="$(get ACCENT_GOLD)"
TEXT_MAIN="$(get TEXT_MAIN)"

# ------------------------------------------------------------------
# 1) Pakketlijsten
# ------------------------------------------------------------------
PKGL="$CFG/config/package-lists"
mkdir -p "$PKGL"

cat > "$PKGL/desktop.list.chroot" <<'EOF'
# XFCE-minimale basis (bewust klein: geen gnome-extra's)
xfce4
xfce4-terminal
xfwm4-themes
thunar
lightdm
lightdm-gtk-greeter
# Compositor voor het glas-effect (xrender werkt zonder GPU)
picom
# HUD-laag
conky-all
# Tiling-raster (devilspie2 regelt 2x2/4x4-plaatsing bij focus)
devilspie2
wmctrl
# Netwerk in de live/desktop-omgeving
network-manager-gnome
nm-tray 2>/dev/null || true
# Firefox ESR als webbrowser/PWA-basis
firefox-esr
# Fonts: HUD-look overal
fonts-jetbrains-mono
xsettings
# GTK-thema's
gtk3-noclipboard 2>/dev/null || true
adwaita-qt6 2>/dev/null || true
EOF

cat > "$PKGL/installer.list.chroot" <<'EOF'
calamares
libxcb-cursor0
EOF

cat > "$PKGL/devstack.list.chroot" <<'EOF'
# Minimal devstack (fase 3)
python3
nodejs
npm
git
EOF

# ------------------------------------------------------------------
# 2) Desktop inrichting
# ------------------------------------------------------------------

# 2a) Autostart picom + conky (na XFCE-start).
SKEL="$CFG/config/includes.chroot/etc/skel"
mkdir -p "$SKEL/.config/autostart"
cat > "$SKEL/.config/autostart/brionai26-desktop.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=BrionAI26 Desktop
Exec=/usr/bin/brionai26-session
EOF
mkdir -p "$CFG/config/includes.chroot/usr/bin"
cat > "$CFG/config/includes.chroot/usr/bin/brionai26-session" <<'EOF'
#!/bin/sh
# BrionAI26-sessie: compositor + HUD, daarna XFCE verder laten opstarten.
picom --config /etc/brionai26/picom.conf &
conky -c /etc/brionai26/conky.conf &
exec true
EOF
chmod 755 "$CFG/config/includes.chroot/usr/bin/brionai26-session"

# 2b) Wallpaper: staalblauwe mission-control-wand gegenereerd door de
# 2150-artwork-hook (geen logo-muur); op alle 3 werkbladen gelijk.
mkdir -p "$CFG/config/includes.chroot/usr/share/backgrounds/brionai26"
mkdir -p "$SKEL/.config/xfce4/xfconf/xfce-perchannel-xml"
cat > "$SKEL/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="image-path" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
        <property name="image-show" type="bool" value="true"/>
        <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
        <property name="last-single-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
        </property>
        <property name="workspace1" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
        </property>
        <property name="workspace2" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
        </property>
      </property>
      <property name="monitor1" type="empty">
        <property name="image-path" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
        <property name="image-show" type="bool" value="true"/>
        <property name="image-style" type="int" value="4"/>
        <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
        <property name="last-single-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
        </property>
        <property name="workspace1" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
        </property>
        <property name="workspace2" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/brionai26/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# 2b2) Desktop-base fallback-herbestemming: elke fallback (greeter,
# xfdesktop-default) toont onze wallpaper i.p.v. de Debian-teal.
mkdir -p "$CFG/config/includes.chroot/usr/share/images/desktop-base"
ln -sf /usr/share/backgrounds/brionai26/wallpaper.png "$CFG/config/includes.chroot/usr/share/images/desktop-base/default"
ln -sf /usr/share/backgrounds/brionai26/wallpaper.png "$CFG/config/includes.chroot/usr/share/images/desktop-base/desktop-background"

# 2c) Donkere look: GTK-thema + LightDM-greeter met wallpaper。
cat > "$SKEL/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Adwaita-dark"/>
    <property name="IconThemeName" type="string" value="Adwaita"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="JetBrains Mono 10"/>
  </property>
</channel>
EOF
mkdir -p "$CFG/config/includes.chroot/etc/lightdm"
cat > "$CFG/config/includes.chroot/etc/lightdm/lightdm.conf" <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
# Live-sessie: automatisch inloggen zoals live-config regelde vóór de
# greeter-switch (live-gebruiker + wachtwoord live, zie live-config).
autologin-user=user
autologin-user-timeout=3
EOF
cat > "$CFG/config/includes.chroot/etc/lightdm/lightdm-gtk-greeter.conf" <<'EOF'
[greeter]
background=/usr/share/backgrounds/brionai26/wallpaper.png
theme-name=Adwaita-dark
EOF

# 2d) Installer-startpictogram op de live-desktop (fase 4).
mkdir -p "$SKEL/Desktop"
cat > "$SKEL/Desktop/install-brionai26.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Installeer BrionAI26
Comment=Installeer BrionAI26 permanent op deze computer
Exec=pkexec calamares
Icon=install
Categories=System
EOF

# 3) Autostart: picom + conky + devilspie2 bij login
AUTO="$CFG/config/includes.chroot/etc/xdg/autostart/brionai26-desktop.desktop"
mkdir -p "$(dirname "$AUTO")"
cat > "$AUTO" <<'EOF'
[Desktop Entry]
Type=Application
Name=BrionAI26 Desktop Session
Exec=/usr/bin/brionai26-session
EOF