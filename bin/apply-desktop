#!/bin/sh

# BrionAI26 — fase 2 inbouw in de live-build ISO.
# Wordt door bin/build-iso aangeroepen ná lb config, vóór lb build.
# Idempotent: veilig herhaald uit te voeren.

set -eu

CFG="$1"   # live-build config-map (bv. build/)
HERE="$(dirname "$0")"

# 1) Pakketlijst fase 2: XFCE + mission-control-onderdelen.
#    Alleen pakketten die geverifieerd in Debian stable bestaan —
#    gtk3-engines-xfce bestaat niet meer in stable; conky is virtueel;
#    conky-std en conky-all conflicteren, dus alleen conky-all.
mkdir -p "$CFG/config/package-lists"
cat > "$CFG/config/package-lists/brionai26-desktop.list.chroot" <<'EOF'
# BrionAI26 mission-control desktop (fase 2)
xfce4
xfce4-terminal
picom
conky-all
devilspie2
wmctrl
chromium
lightdm
EOF

# 2) Skel-map: alles uit desktop/skel/ komt in /etc/skel van de ISO, zodat
#    elke nieuwe gebruiker de mission-control-opzet krijgt.
if [ -d "$HERE/../desktop/skel" ]; then
    mkdir -p "$CFG/config/includes.chroot/etc"
    cp -r "$HERE/../desktop/skel" "$CFG/config/includes.chroot/etc/skel"
    echo "== skel geplaatst: $(find "$CFG/config/includes.chroot/etc/skel" -type f | wc -l) bestanden =="
else
    echo "WAARSCHUWING: desktop/skel niet gevonden — desktop wordt NIET meegebouwd" >&2
    exit 3
fi

# 3) Autostart: picom + conky + devilspie2 bij login
AUTO="$CFG/config/includes.chroot/etc/xdg/autostart/brionai26-desktop.desktop"
mkdir -p "$(dirname "$AUTO")"
cat > "$AUTO" <<'EOF'
[Desktop Entry]
Type=Application
Name=BrionAI26 Mission Control
Exec=sh -c 'picom --config $HOME/.config/picom/picom.conf & conky -c $HOME/.config/conky/conky.conf & devilspie2 -a &'
OnlyShowIn=XFCE;
EOF

echo "== fase-2 bestanden geplaatst in $CFG =="
