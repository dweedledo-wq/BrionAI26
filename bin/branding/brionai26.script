# BrionAI26 boot splash: staalblauwe wand, gouden merk-logo, laadbalk.
# Officiele Plymouth-script-API (Sprite.New/Image.New/SetColor bestaan
# niet en braken de splash op ISO 082014 -- deze versie gebruikt alleen
# gedocumenteerde functies).

Window.SetBackgroundTopColor(0.024, 0.043, 0.086);
Window.SetBackgroundBottomColor(0.024, 0.043, 0.086);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo = Image("logo.png");
logo_scaled = logo.Scale(logo.GetWidth() * 0.35, logo.GetHeight() * 0.35);
logo_sprite = Sprite(logo_scaled);
logo_sprite.SetPosition(screen_width / 2 - logo_scaled.GetWidth() / 2,
                        screen_height / 2 - logo_scaled.GetHeight() / 2 - 60,
                        100);

bar_w = screen_width * 0.20;
bar_x = screen_width / 2 - bar_w / 2;
bar_y = screen_height / 2 + 90;

track_img = Image("bar_track.png");
track_scaled = track_img.Scale(bar_w, 4);
track_sprite = Sprite(track_scaled);
track_sprite.SetPosition(bar_x, bar_y, 100);

fill_img = Image("bar_fill.png");
fill_sprite = Sprite(fill_img.Scale(1, 4));
fill_sprite.SetPosition(bar_x, bar_y, 101);

fun boot_progress(duration, progress) {
    fill_w = Math.Max(bar_w * progress, 1);
    fill_sprite.SetImage(fill_img.Scale(fill_w, 4));
}

Plymouth.SetBootProgressFunction(boot_progress);
