#!/bin/sh

# Draait binnen een privileged debian:stable container (zie bin/build-iso-docker).
# Bouwt de BrionAI26 ISO: fase 1 (basis) + fase 2 (mission-control desktop).

set -eu

export DEBIAN_FRONTEND=noninteractive

# apt kan bij tijdelijke mirror-hik falen; max 3 pogingen met korte pauze.
n=0
until apt-get update; do
    n=$((n+1))
    if [ "$n" -ge 3 ]; then
        echo "apt-get update faalde na 3 pogingen" >&2
        exit 100
    fi
    echo "apt-get update poging $n faalde — opnieuw na 10s" >&2
    sleep 10
done

n=0
until apt-get install --yes --no-install-recommends live-build; do
    n=$((n+1))
    if [ "$n" -ge 3 ]; then
        echo "apt-get install faalde na 3 pogingen" >&2
        exit 100
    fi
    echo "apt-get install poging $n faalde — opnieuw na 10s" >&2
    sleep 10
done

WORKDIR="${1:-build}"
mkdir -p "$WORKDIR" dist
cd "$WORKDIR"

# Minimale configuratie: Debian stable, amd64, iso-hybrid.
lb config \
    --distribution stable \
    --architecture amd64 \
    --binary-images iso-hybrid \
    --archive-areas "main" \
    --debian-installer none \
    --checksums sha256

# Fase 2: mission-control desktop inbouwen (pakketten + skel + autostart)
if [ -x /app/bin/apply-desktop ] || [ -f /app/bin/apply-desktop ]; then
    sh /app/bin/apply-desktop "$(pwd)"
fi

# lb build logt naar stdout; tee vangt alles op in live-build.log zodat de
# workflow het log bij faal kan uitlezen (build/ is in de container gemount).
# POSIX-veilig: pipeline-status is die van tee (altijd 0), daarom schrijft de
# subshell de echte lb build exit-code naar een statusbestand.
STATUS="$(pwd)/.lb-build-status"
echo 0 > "$STATUS"
(lb build 2>&1 || echo $? > "$STATUS") | tee live-build.log
RC="$(cat "$STATUS")"
rm -f "$STATUS"
if [ "$RC" -ne 0 ]; then
    echo "lb build faalde met exit $RC" >&2
    exit "$RC"
fi

mv live-image-amd64.hybrid.iso ../dist/brionai26-amd64.hybrid.iso

echo "== ISO SHA256 =="
cd ../dist
sha256sum brionai26-amd64.hybrid.iso | tee SHA256SUMS
cd -

echo "== Build voltooid =="
ls -lah ../dist/